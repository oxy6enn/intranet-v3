  "description": "Internal auth training app",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:e2e": "set E2E_TEST=1&& next start -p 3000",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.tests.json && node .tmp-tests/tests/run-tests.js",
