{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".tmp-tests",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "src/lib/temp-password.ts",
    "src/lib/route-access.ts",
    "src/lib/access-policy.ts",
    "src/lib/user-role.ts",
    "src/lib/user-status.ts",
    "src/lib/permission-codes.ts",
    "src/lib/permission-check.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".tmp-tests"
  ]
}
